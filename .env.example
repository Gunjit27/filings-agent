# LLM (via LiteLLM). Default: gpt-oss-20b on Groq's free tier, judged by Qwen.
# Any LiteLLM model works, e.g. gemini/gemini-3.8-flash with GEMINI_API_KEY.
LLM_MODEL=groq/openai/gpt-oss-20b
JUDGE_MODEL=groq/qwen/qwen3.8-27b
GROQ_API_KEY=
LLM_RPM=25
# Vector store. Leave QDRANT_URL empty to use an embedded local store at ./qdrant_local
QDRANT_URL=
QDRANT_API_KEY=
# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
