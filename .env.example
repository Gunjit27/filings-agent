# LLM (via LiteLLM). Default: Gemini Flash.
LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=
# Vector store. Leave QDRANT_URL empty to use an embedded local store at ./qdrant_local
QDRANT_URL=
QDRANT_API_KEY=
# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
